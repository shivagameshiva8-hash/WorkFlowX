<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WorkflowX | Secure Login</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --blue: #398cff;
            --cyan: #51e5ff;
            --purple: #a45cff;
            --text: #f5f7ff;
            --muted: #9aa9ca;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            overflow: hidden;
            display: grid;
            place-items: center;
            font-family: "Inter", sans-serif;
            color: var(--text);
            background:
                radial-gradient(ellipse at 15% 20%, #102c60 0%, transparent 38%),
                radial-gradient(ellipse at 85% 80%, #281044 0%, transparent 38%),
                #030611;
        }

        /* ---------- SPACE BACKGROUND ---------- */

        .space {
            position: fixed;
            inset: 0;
            overflow: hidden;
            perspective: 1000px;
            isolation: isolate;
            pointer-events: none;
        }

        .nebula {
            position: absolute;
            width: 65vw;
            height: 65vw;
            max-width: 850px;
            max-height: 850px;
            border-radius: 50%;
            filter: blur(100px);
            opacity: .14;
            animation: nebulaDrift 18s ease-in-out infinite alternate;
        }

        .nebula.one {
            background: #176cff;
            top: -35%;
            left: -15%;
        }

        .nebula.two {
            background: #8b35ff;
            bottom: -45%;
            right: -10%;
            animation-delay: -8s;
        }

        .stars {
            position: absolute;
            inset: 0;
            opacity: .65;
            background-image:
                radial-gradient(1px 1px at 8% 18%, white 99%, transparent),
                radial-gradient(2px 2px at 22% 75%, #83c8ff 99%, transparent),
                radial-gradient(1px 1px at 37% 32%, white 99%, transparent),
                radial-gradient(2px 2px at 73% 17%, #b2bfff 99%, transparent),
                radial-gradient(1px 1px at 89% 64%, white 99%, transparent),
                radial-gradient(1px 1px at 62% 83%, white 99%, transparent),
                radial-gradient(2px 2px at 48% 9%, #86eaff 99%, transparent),
                radial-gradient(1px 1px at 95% 35%, white 99%, transparent);
            background-size: 400px 350px;
            animation: starMove 90s linear infinite;
        }

        .grid-floor {
            position: absolute;
            width: 150%;
            height: 50%;
            left: -25%;
            bottom: -24%;
            transform: rotateX(68deg);
            transform-origin: center top;
            background-image:
                linear-gradient(#397dff16 1px, transparent 1px),
                linear-gradient(90deg, #397dff16 1px, transparent 1px);
            background-size: 65px 65px;
            mask-image: linear-gradient(to bottom, transparent, black 35%, transparent);
        }

        /* ---------- FLOATING 3D OBJECTS ---------- */

        .object {
            position: absolute;
            transform-style: preserve-3d;
            will-change: transform;
            transition: transform .25s ease-out;
        }

        .planet {
            border-radius: 50%;
            background:
                radial-gradient(circle at 30% 25%, #b9eaff 0%, #478dff 9%, #183f9d 38%, #080d29 76%);
            box-shadow:
                inset -18px -22px 35px #02040f,
                inset 8px 8px 25px #91d7ff66,
                0 0 45px #317eff45;
            animation: planetFloat 10s ease-in-out infinite;
        }

        .planet.left {
            width: clamp(170px, 23vw, 320px);
            height: clamp(170px, 23vw, 320px);
            left: -8%;
            top: 17%;
        }

        .planet.right {
            width: clamp(120px, 16vw, 220px);
            height: clamp(120px, 16vw, 220px);
            right: -4%;
            top: 9%;
            background:
                radial-gradient(circle at 30% 25%, #e1c3ff, #8649ff 20%, #29145d 62%, #070719 85%);
            box-shadow:
                inset -20px -20px 30px #050414,
                0 0 60px #9148ff38;
            animation-delay: -4s;
        }

        .orbit {
            position: absolute;
            width: 145%;
            height: 36%;
            top: 32%;
            left: -22%;
            border: 2px solid #68caff65;
            border-radius: 50%;
            transform: rotate(-20deg);
            box-shadow: 0 0 12px #3c9dff55, inset 0 0 10px #3c9dff22;
        }

        .orbit::after {
            content: "";
            position: absolute;
            top: 7%;
            left: 12%;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #80eaff;
            box-shadow: 0 0 15px 5px #378dff;
        }

        .planet.left .orbit {
            animation: orbitSpin 28s linear infinite;
        }

        .planet.right .orbit {
            width: 155%;
            left: -25%;
            border-color: #b68cff70;
            transform: rotate(35deg);
            animation: orbitSpin 35s linear infinite reverse;
        }

        .orb {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 25%, #ffffff, #65dfff 10%, #3b6cff 42%, #1b1858 78%);
            border: 1px solid #a8eaff75;
            box-shadow: inset -8px -10px 20px #080a2e, 0 0 30px #438dff65;
            animation: orbFloat 8s ease-in-out infinite;
        }

        .orb.a {
            top: 17%;
            left: 23%;
        }

        .orb.b {
            right: 21%;
            bottom: 18%;
            width: 34px;
            height: 34px;
            animation-delay: -3s;
        }

        .orb.c {
            left: 14%;
            bottom: 16%;
            width: 24px;
            height: 24px;
            animation-delay: -5s;
        }

        .wire-shape {
            width: 90px;
            height: 90px;
            border: 1px solid #70baff65;
            border-radius: 20px;
            transform: rotate(35deg) skew(-8deg);
            box-shadow: inset 0 0 22px #438cff16, 0 0 25px #458bff12;
            animation: shapeFloat 12s ease-in-out infinite;
        }

        .wire-shape.one {
            top: 21%;
            right: 16%;
        }

        .wire-shape.two {
            bottom: 17%;
            left: 22%;
            width: 58px;
            height: 58px;
            border-color: #b08aff70;
            animation-delay: -6s;
        }

        .ring {
            position: absolute;
            width: 110px;
            height: 110px;
            border: 2px solid #9d7aff70;
            border-radius: 50%;
            transform: rotateX(65deg) rotateZ(25deg);
            box-shadow: 0 0 18px #804cff2b;
            animation: ringSpin 16s linear infinite;
        }

        .ring.one {
            top: 14%;
            right: 30%;
        }

        .ring.two {
            bottom: 15%;
            right: 17%;
            width: 65px;
            height: 65px;
            border-color: #5ee9ff75;
            animation-duration: 22s;
            animation-direction: reverse;
        }

        /* ---------- PARTICLES ---------- */

        .particle {
            position: absolute;
            width: 3px;
            height: 3px;
            border-radius: 50%;
            background: #a8eaff;
            box-shadow: 0 0 12px 3px #438dff88;
            animation: particleDrift 9s ease-in-out infinite;
        }

        .p1 { left: 12%; top: 40%; }
        .p2 { left: 34%; top: 16%; animation-delay: -3s; }
        .p3 { right: 13%; top: 42%; animation-delay: -5s; }
        .p4 { right: 29%; bottom: 22%; animation-delay: -2s; }
        .p5 { left: 29%; bottom: 13%; animation-delay: -7s; }
        .p6 { left: 80%; top: 12%; animation-delay: -4s; }

        /* ---------- MAIN LAYOUT ---------- */

        .scene {
            position: relative;
            z-index: 2;
            width: 100%;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            perspective: 1200px;
        }

        .login-card {
            position: relative;
            width: min(100%, 440px);
            padding: 38px 36px 30px;
            overflow: hidden;
            border-radius: 28px;
            border: 1px solid #a7c9ff40;

            background:
                linear-gradient(145deg, #ffffff12, transparent 30%),
                linear-gradient(145deg, #142344d9, #080f25e8 55%, #17102ee8);

            -webkit-backdrop-filter: blur(28px) saturate(150%);
            backdrop-filter: blur(28px) saturate(150%);

            box-shadow:
                0 35px 100px #0009,
                0 0 55px #277dff1b,
                inset 0 1px 0 #ffffff40,
                inset 0 -1px 0 #8caeff25;

            transform-style: preserve-3d;
            animation: cardFloat 7s ease-in-out infinite;
            transition: transform .25s ease-out, box-shadow .35s ease;
        }

        /* Glass reflection */
        .login-card::before {
            content: "";
            position: absolute;
            top: -60%;
            left: -35%;
            width: 90%;
            height: 100%;
            transform: rotate(-28deg);
            background: linear-gradient(
                180deg,
                transparent,
                #ffffff0b 35%,
                #83caff18 48%,
                transparent 70%
            );
            pointer-events: none;
        }

        .login-card::after {
            content: "";
            position: absolute;
            inset: 0;
            padding: 1px;
            border-radius: inherit;
            background: linear-gradient(
                135deg,
                #ffffff70,
                #70d8ff25 28%,
                transparent 48%,
                #a36dff55 78%,
                #ffffff28
            );
            -webkit-mask:
                linear-gradient(#fff 0 0) content-box,
                linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
        }

        .card-content {
            position: relative;
            z-index: 1;
            transform: translateZ(25px);
        }

        /* ---------- BRAND ---------- */

        .brand {
            text-align: center;
            margin-bottom: 32px;
        }

        .logo {
            position: relative;
            display: grid;
            place-items: center;
            width: 58px;
            height: 58px;
            margin: 0 auto 17px;
            border-radius: 18px;
            border: 1px solid #a8baff80;
            background: linear-gradient(145deg, #5cc9ff, #376aff 48%, #984cff);
            box-shadow:
                0 0 30px #3b80ff70,
                inset 0 1px 0 #ffffff80;
            transform: rotate(-6deg);
        }

        .logo svg {
            width: 33px;
            height: 33px;
            filter: drop-shadow(0 3px 5px #14145e80);
        }

        .brand h1 {
            font-size: clamp(29px, 5vw, 34px);
            font-weight: 800;
            letter-spacing: -1.6px;
        }

        .brand h1 span {
            background: linear-gradient(90deg, #ffffff, #7de5ff 50%, #a78bff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .brand p {
            margin-top: 9px;
            font-size: 12px;
            letter-spacing: .1px;
            color: #aab8d8;
        }

        /* ---------- FORM ---------- */

        .field {
            margin-bottom: 19px;
        }

        .field label {
            display: block;
            margin-bottom: 9px;
            font-size: 12px;
            font-weight: 600;
            color: #e6edff;
        }

        .input-wrap {
            position: relative;
            display: flex;
            align-items: center;
            min-height: 54px;
            border: 1px solid #90b5ff43;
            border-radius: 13px;
            background: #101b37a8;
            transition: border-color .25s, box-shadow .25s, background .25s;
        }

        .input-wrap:focus-within {
            border-color: #60caff;
            background: #142343db;
            box-shadow: 0 0 0 3px #398cff1c, 0 0 22px #398cff20;
        }

        .field-icon {
            width: 19px;
            height: 19px;
            margin-left: 16px;
            flex-shrink: 0;
            color: #9abaff;
        }

        .input-wrap input {
            width: 100%;
            min-width: 0;
            padding: 15px 13px;
            border: none;
            outline: none;
            color: #fff;
            background: transparent;
            font-family: inherit;
            font-size: 13px;
        }

        .input-wrap input::placeholder {
            color: #7f91b8;
        }

        .password-toggle {
            display: grid;
            place-items: center;
            flex-shrink: 0;
            width: 44px;
            height: 48px;
            margin-right: 3px;
            color: #a5b9e7;
            background: transparent;
            border: none;
            cursor: pointer;
        }

        .password-toggle svg {
            width: 19px;
            height: 19px;
        }

        .password-toggle:hover {
            color: white;
        }

        .form-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 4px 0 25px;
            font-size: 11px;
        }

        .remember {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #b4c1df;
            cursor: pointer;
        }

        .remember input {
            width: 15px;
            height: 15px;
            accent-color: #438bff;
            cursor: pointer;
        }

        .form-options a {
            color: #75aaff;
            text-decoration: none;
        }

        .form-options a:hover {
            color: #b3dcff;
            text-decoration: underline;
        }

        /* ---------- LOGIN BUTTON ---------- */

        .login-button {
            position: relative;
            width: 100%;
            min-height: 55px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            overflow: hidden;
            border: 1px solid #a4d5ff8c;
            border-radius: 14px;
            color: white;
            background: linear-gradient(100deg, #347fff, #5260ff 53%, #9a55f5);
            box-shadow:
                0 8px 28px #4b66ff3d,
                inset 0 1px 0 #ffffff65;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: transform .25s, box-shadow .25s, filter .25s;
        }

        .login-button::before {
            content: "";
            position: absolute;
            top: 0;
            left: -110%;
            width: 70%;
            height: 100%;
            transform: skewX(-22deg);
            background: linear-gradient(90deg, transparent, #ffffff40, transparent);
            transition: left .6s ease;
        }

        .login-button:hover {
            transform: translateY(-2px);
            filter: brightness(1.12);
            box-shadow:
                0 12px 36px #4b66ff5c,
                0 0 25px #5c79ff40,
                inset 0 1px 0 #ffffff80;
        }

        .login-button:hover::before {
            left: 140%;
        }

        .login-button:active {
            transform: translateY(0) scale(.99);
        }

        .login-button:disabled {
            opacity: .75;
            cursor: wait;
        }

        .arrow {
            font-size: 22px;
            font-weight: 400;
            transition: transform .25s;
        }

        .login-button:hover .arrow {
            transform: translateX(4px);
        }

        /* ---------- SECURE FOOTER ---------- */

        .secure {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 29px;
            color: #8c9fc8;
            font-size: 9px;
            letter-spacing: 3px;
        }

        .secure::before,
        .secure::after {
            content: "";
            height: 1px;
            flex: 1;
            background: linear-gradient(90deg, transparent, #90baff65);
        }

        .secure::after {
            background: linear-gradient(90deg, #90baff65, transparent);
        }

        .shield {
            color: #83aaff;
            font-size: 15px;
        }

        .motto {
            margin-top: 19px;
            text-align: center;
            color: #b4c4e6;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 3px;
        }

        .motto span {
            color: #61caff;
        }

        .error-message {
            margin-bottom: 18px;
            padding: 11px 13px;
            border: 1px solid #ff7c9b65;
            border-radius: 10px;
            background: #ff426d12;
            color: #ffb6c6;
            font-size: 12px;
            line-height: 1.5;
        }

        /* ---------- ANIMATIONS ---------- */

        @keyframes cardFloat {
            0%, 100% { translate: 0 0; }
            50% { translate: 0 -8px; }
        }

        @keyframes planetFloat {
            0%, 100% { translate: 0 0; }
            50% { translate: 0 -18px; }
        }

        @keyframes orbFloat {
            0%, 100% { translate: 0 0; }
            50% { translate: 12px -17px; }
        }

        @keyframes shapeFloat {
            0%, 100% { translate: 0 0; }
            50% { translate: -10px -15px; }
        }

        @keyframes orbitSpin {
            from { rotate: 0deg; }
            to { rotate: 360deg; }
        }

        @keyframes ringSpin {
            from { rotate: 0deg; }
            to { rotate: 360deg; }
        }

        @keyframes particleDrift {
            0%, 100% { translate: 0 0; opacity: .35; }
            50% { translate: 14px -24px; opacity: 1; }
        }

        @keyframes nebulaDrift {
            from { transform: translate3d(-2%, 0, 0) scale(1); }
            to { transform: translate3d(4%, 3%, 0) scale(1.12); }
        }

        @keyframes starMove {
            from { background-position: 0 0; }
            to { background-position: 400px 350px; }
        }

        /* ---------- RESPONSIVE ---------- */

        @media (max-width: 600px) {
            body {
                overflow-y: auto;
            }

            .scene {
                min-height: 100svh;
                padding: 20px 15px;
            }

            .login-card {
                padding: 31px 23px 26px;
                border-radius: 23px;
            }

            .brand {
                margin-bottom: 27px;
            }

            .brand p {
                font-size: 11px;
            }

            .planet.left {
                left: -30%;
                top: 8%;
                opacity: .55;
            }

            .planet.right {
                right: -28%;
                top: 68%;
                opacity: .5;
            }

            .wire-shape.one {
                right: 4%;
            }

            .form-options {
                font-size: 10px;
            }

            .motto {
                font-size: 9px;
                letter-spacing: 2px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>

<body>

    <!-- Animated space environment -->
    <div class="space" id="space">
        <div class="nebula one"></div>
        <div class="nebula two"></div>
        <div class="stars"></div>
        <div class="grid-floor"></div>

        <div class="object planet left" data-depth="0.035">
            <div class="orbit"></div>
        </div>

        <div class="object planet right" data-depth="0.06">
            <div class="orbit"></div>
        </div>

        <div class="object orb a" data-depth="0.09"></div>
        <div class="object orb b" data-depth="0.13"></div>
        <div class="object orb c" data-depth="0.07"></div>

        <div class="object wire-shape one" data-depth="0.12"></div>
        <div class="object wire-shape two" data-depth="0.08"></div>

        <div class="object ring one" data-depth="0.1"></div>
        <div class="object ring two" data-depth="0.15"></div>

        <div class="particle p1"></div>
        <div class="particle p2"></div>
        <div class="particle p3"></div>
        <div class="particle p4"></div>
        <div class="particle p5"></div>
        <div class="particle p6"></div>
    </div>

    <!-- Login interface -->
    <main class="scene">
        <section class="login-card" id="loginCard">
            <div class="card-content">

                <header class="brand">
                    <div class="logo">
                        <svg viewBox="0 0 48 48" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M24 3L43 14V34L24 45L5 34V14L24 3Z"
                                  stroke="white" stroke-width="2.5"/>
                            <path d="M24 3V24L43 14M24 24L5 14M24 24V45"
                                  stroke="white" stroke-width="2"/>
                            <path d="M24 24L43 34L24 45L5 34L24 24Z"
                                  fill="#DDF8FF" fill-opacity=".25"/>
                        </svg>
                    </div>

                    <h1>Work<span>FlowX</span></h1>
                    <p>Task Management for a Smarter Tomorrow</p>
                </header>

                <% if (typeof error !== "undefined" && error) { %>
                    <div class="error-message" role="alert">
                        <%= error %>
                    </div>
                <% } %>

                <form action="/auth/login" method="POST" id="loginForm">

                    <div class="field">
                        <label for="email">Email Address</label>

                        <div class="input-wrap">
                            <svg class="field-icon" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor"
                                 stroke-width="1.8">
                                <rect x="3" y="5" width="18" height="14" rx="2"/>
                                <path d="M3 7L12 13L21 7"/>
                            </svg>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="you@example.com"
                                autocomplete="username"
                                required>
                        </div>
                    </div>

                    <div class="field">
                        <label for="password">Password</label>

                        <div class="input-wrap">
                            <svg class="field-icon" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor"
                                 stroke-width="1.8">
                                <rect x="4" y="10" width="16" height="11" rx="2"/>
                                <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
                                <path d="M12 14v3"/>
                            </svg>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Enter your password"
                                autocomplete="current-password"
                                required>

                            <button
                                class="password-toggle"
                                type="button"
                                id="togglePassword"
                                aria-label="Show password"
                                aria-pressed="false">

                                <svg id="eyeIcon" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor"
                                     stroke-width="1.8">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="form-options">
                        <label class="remember">
                            <input type="checkbox" name="remember" value="yes">
                            <span>Remember me</span>
                        </label>

                        <!-- Connect this to a real password recovery route if available -->
                        <a href="/auth/forgot-password">Forgot password?</a>
                    </div>

                    <button class="login-button" type="submit" id="loginButton">
                        <span id="buttonText">Login</span>
                        <span class="arrow" aria-hidden="true">→</span>
                    </button>


                    <p class="signup">
                        Don't have an account?
                        <a href="/auth/register">Create an account</a>
                    </p>                    

                </form>

                <div class="secure">
                    <span class="shield" aria-hidden="true">♢</span>
                    <span>SECURE ACCESS</span>
                </div>

                <div class="motto">
                    PLAN <span>•</span> TRACK <span>•</span> ACHIEVE
                </div>

            </div>
        </section>
    </main>

    <script>
        // Show or hide password
        const passwordInput = document.getElementById("password");
        const togglePassword = document.getElementById("togglePassword");
        const eyeIcon = document.getElementById("eyeIcon");

        togglePassword.addEventListener("click", () => {
            const showing = passwordInput.type === "password";

            passwordInput.type = showing ? "text" : "password";
            togglePassword.setAttribute("aria-pressed", String(showing));
            togglePassword.setAttribute(
                "aria-label",
                showing ? "Hide password" : "Show password"
            );

            eyeIcon.innerHTML = showing
                ? `<path d="M3 3L21 21"/>
                   <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/>
                   <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.5 0 10 7 10 7a15 15 0 0 1-3 3.8"/>
                   <path d="M6.2 6.2C3.5 8 2 12 2 12s3.5 7 10 7c1.1 0 2.1-.2 3-.5"/>`
                : `<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/>
                   <circle cx="12" cy="12" r="3"/>`;
        });

        // Subtle mouse parallax
        const space = document.getElementById("space");
        const card = document.getElementById("loginCard");
        const objects = document.querySelectorAll("[data-depth]");
        const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)"
        ).matches;

        if (!reduceMotion) {
            let framePending = false;
            let mouseX = 0;
            let mouseY = 0;

            document.addEventListener("mousemove", (event) => {
                mouseX = (event.clientX / window.innerWidth - 0.5) * 2;
                mouseY = (event.clientY / window.innerHeight - 0.5) * 2;

                if (framePending) return;
                framePending = true;

                requestAnimationFrame(() => {
                    objects.forEach((object) => {
                        const depth = Number(object.dataset.depth || 0.05);
                        object.style.marginLeft = `${mouseX * depth * 180}px`;
                        object.style.marginTop = `${mouseY * depth * 180}px`;
                    });

                    // Keep perspective restrained for comfortable reading.
                    card.style.transform =
                        `rotateY(${mouseX * 2}deg) rotateX(${-mouseY * 2}deg)`;

                    framePending = false;
                });
            });

            document.addEventListener("mouseleave", () => {
                card.style.transform = "rotateY(0deg) rotateX(0deg)";

                objects.forEach((object) => {
                    object.style.marginLeft = "0px";
                    object.style.marginTop = "0px";
                });
            });
        }

        // Small loading feedback; the browser still submits the real form.
        const loginForm = document.getElementById("loginForm");
        const loginButton = document.getElementById("loginButton");
        const buttonText = document.getElementById("buttonText");

        loginForm.addEventListener("submit", () => {
            if (!loginForm.checkValidity()) return;

            loginButton.disabled = true;
            buttonText.textContent = "Signing in...";
        });
    </script>

</body>
</html>