<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manager Analytics | WorkFlowX</title>
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/tasks.css">

    <style>
        .analytics-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .analytics-card {
            background: #ffffff;
            padding: 25px;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(16, 24, 40, 0.04);
        }

        .analytics-card .card-label {
            color: #667085;
            font-size: 14px;
            font-weight: 600;
        }

        .analytics-card h2 {
            margin-top: 16px;
            font-size: 34px;
            color: #172554;
        }

        .analytics-card a {
            color: inherit;
            text-decoration: none;
        }

        .analytics-card a:hover {
            text-decoration: underline;
        }

        .analytics-card.total {
            border-top: 4px solid #3548d4;
        }

        .analytics-card.pending {
            border-top: 4px solid #d97706;
        }

        .analytics-card.progress {
            border-top: 4px solid #2563eb;
        }

        .analytics-card.completed {
            border-top: 4px solid #16a34a;
        }

        .analytics-card.overdue {
            border-top: 4px solid #dc2626;
        }

        .analytics-section {
            background: white;
            padding: 25px;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
        }

        .analytics-section h2 {
            margin-bottom: 20px;
            font-size: 20px;
        }

        .metric-row {
            margin-bottom: 22px;
        }

        .metric-header {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 9px;
            font-size: 14px;
        }

        .progress-track {
            height: 10px;
            background: #eef0f5;
            border-radius: 20px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            border-radius: 20px;
        }

        .fill-pending {
            background: #d97706;
        }

        .fill-progress {
            background: #2563eb;
        }

        .fill-completed {
            background: #16a34a;
        }

        .fill-overdue {
            background: #dc2626;
        }

        @media (max-width: 1000px) {
            .analytics-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 700px) {
            .analytics-grid {
                grid-template-columns: 1fr;
            }

            .analytics-card {
                padding: 20px;
            }
        }
    </style>
</head>
<body>

<div class="layout">

    <aside class="sidebar">
        <h2 class="brand">☑ WorkFlowX</h2>

        <nav>
            <a href="/manager/dashboard">⌂ Dashboard</a>
            <a href="/manager/tasks/new">＋ Create / Assign Task</a>
            <a href="/manager/tasks">☷ View All Tasks</a>
            <a href="/manager/employee-tasks">♟ Employee Tracking</a>
            <a href="/manager/analytics" class="active">▥ Analytics</a>
            <a href="/manager/overdue-tasks">◷ Overdue Tasks</a>
        </nav>
    </aside>

    <main class="main-content">

        <header class="topbar">
            <span>WorkFlowX / Manager Analytics</span>

            <form action="/auth/logout" method="POST">
                <button type="submit" class="logout-button">Logout</button>
            </form>
        </header>

        <section class="page-heading">
            <div>
                <h1>Manager Analytics</h1>
                <p>Monitor task completion and employee workload.</p>
            </div>
        </section>

        <section class="analytics-grid">

            <div class="analytics-card total">
                <span class="card-label">Total Tasks</span>
                <h2><%= totalTasks %></h2>
            </div>

            <div class="analytics-card pending">
                <span class="card-label">Pending</span>
                <h2><%= pendingTasks %></h2>
            </div>

            <div class="analytics-card progress">
                <span class="card-label">In Progress</span>
                <h2><%= inProgressTasks %></h2>
            </div>

            <div class="analytics-card completed">
                <span class="card-label">Completed</span>
                <h2><%= completedTasks %></h2>
            </div>

            <div class="analytics-card overdue">
                <span class="card-label">Overdue Tasks</span>
                <h2>
                    <a href="/manager/overdue-tasks"><%= overdueTasks %></a>
                </h2>
            </div>

        </section>

        <section class="analytics-section">
            <h2>Task Status Overview</h2>

            <% 
                const safeTotal = Number(totalTasks) || 0;
                const pendingPercent = safeTotal ? (pendingTasks / safeTotal) * 100 : 0;
                const progressPercent = safeTotal ? (inProgressTasks / safeTotal) * 100 : 0;
                const completedPercent = safeTotal ? (completedTasks / safeTotal) * 100 : 0;
                const overduePercent = safeTotal ? (overdueTasks / safeTotal) * 100 : 0;
            %>

            <div class="metric-row">
                <div class="metric-header">
                    <span>Pending</span>
                    <strong><%= pendingTasks %> (<%= Math.round(pendingPercent) %>%)</strong>
                </div>
                <div class="progress-track">
                    <div class="progress-fill fill-pending"
                         style="width: <%= pendingPercent %>%"></div>
                </div>
            </div>

            <div class="metric-row">
                <div class="metric-header">
                    <span>In Progress</span>
                    <strong><%= inProgressTasks %> (<%= Math.round(progressPercent) %>%)</strong>
                </div>
                <div class="progress-track">
                    <div class="progress-fill fill-progress"
                         style="width: <%= progressPercent %>%"></div>
                </div>
            </div>

            <div class="metric-row">
                <div class="metric-header">
                    <span>Completed</span>
                    <strong><%= completedTasks %> (<%= Math.round(completedPercent) %>%)</strong>
                </div>
                <div class="progress-track">
                    <div class="progress-fill fill-completed"
                         style="width: <%= completedPercent %>%"></div>
                </div>
            </div>

            <div class="metric-row">
                <div class="metric-header">
                    <span>Overdue</span>
                    <strong><%= overdueTasks %> (<%= Math.round(overduePercent) %>%)</strong>
                </div>
                <div class="progress-track">
                    <div class="progress-fill fill-overdue"
                         style="width: <%= overduePercent %>%"></div>
                </div>
            </div>

        </section>

        

    </main>
</div>

</body>
</html>
